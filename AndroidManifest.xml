<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bedroomtv.home">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Reading the Wi-Fi network name needs location; granted over adb by build.sh. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The TV's Bluetooth page (a settings slice) refuses callers without this; build.sh grants it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Needed to see other apps' launch intents on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Its own task, so the settings key opens it over the running app instead of
             bringing the home screen's task (and the launcher) to the front. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.bedroomtv.home.panel"
            android:theme="@style/Theme.TvHome.Panel" />

        <activity
            android:name=".AppsPanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TvHome.Panel" />

        <!-- Brings our home back whenever Google TV's home or the setup-recovery home shows,
             and turns the remote's settings key into our quick settings panel. -->
        <service
            android:name=".HomeGuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_guard" />
        </service>
    </application>
</manifest>
