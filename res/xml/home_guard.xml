<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes from Google TV's launcher and the setup-recovery home are delivered,
     so the service stays idle otherwise. Window content is read only when the settings key is
     pressed, to tell which app is in front. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tungsten.setupwraith"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:canTakeScreenshot="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows"
    android:description="@string/guard_description" />
