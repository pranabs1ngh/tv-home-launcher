<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingEnd="40dp"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Bold hour, thin minutes. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:format12Hour="h"
                    android:format24Hour="HH"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_thin"
                    android:format12Hour=":mm"
                    android:format24Hour=":mm"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp" />
            </LinearLayout>

            <!-- Bold day name, light date. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:format12Hour="EEEE"
                    android:format24Hour="EEEE"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:format12Hour=", d MMMM"
                    android:format24Hour=", d MMMM"
                    android:textColor="#CCFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wifi_pill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/pill_bg"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_wifi"
                android:tint="@color/pill_text" />

            <TextView
                android:id="@+id/wifi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:duplicateParentState="true"
                android:fontFamily="@font/inter_light"
                android:text="Wi-Fi"
                android:textColor="@color/pill_text"
                android:textSize="17sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/settings_pill"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/pill_text" />
    </LinearLayout>

    <!-- Rows scroll inside this area; anything sliding up past its top edge is hidden, so it never
         runs into the clock. -->
    <com.bedroomtv.home.RowsFrame
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="40dp"
        android:layout_marginStart="-40dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/rows_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_medium"
                android:text="Apps"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <!-- Scrolls sideways once more apps are added than fit on screen. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/apps_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_medium"
                android:text="Games"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/inputs_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </com.bedroomtv.home.RowsFrame>
</LinearLayout>
