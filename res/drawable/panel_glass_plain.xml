<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass used over other apps, where the blurred home wallpaper would be the wrong picture. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient android:angle="270" android:startColor="#E6181A20" android:endColor="#EB0B0C10" />
        </shape>
    </item>
</layer-list>
