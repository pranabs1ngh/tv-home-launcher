<?xml version="1.0" encoding="utf-8"?>
<!-- macOS dark-mode tiles: faint glass normally, a soft grey highlight when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#5C8E929C" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#14FFFFFF" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#14FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
